# Copie este arquivo para ".env" e preencha os valores.

# Endereço final do site, sem barra no fim. Usado no Open Graph, canonical e dados estruturados.
# Exemplo: https://thiagosantos.com.br
VITE_SITE_URL=

# Google Analytics 4 (ex.: G-XXXXXXXXXX). Deixe vazio para não carregar.
VITE_GA_ID=

# Meta Pixel (ex.: 123456789012345). Deixe vazio para não carregar.
VITE_META_PIXEL_ID=
